{
	"extends": "./.svelte-kit/tsconfig.json",
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true,
		"types": [
			"node",
			"estree",
			"json-schema"
		],
		"allowImportingTsExtensions": true,
		"module": "esnext",
		"noEmit": true,
		"target": "esnext",
		"moduleResolution": "node",
	}
}